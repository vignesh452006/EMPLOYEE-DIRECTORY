<header class="topbar">
  <div class="container topbar-inner">
    <a href="/" class="brand">
      <svg class="icon icon-lg brand-icon"><use href="#icon-logo"></use></svg>
      <span class="brand-text">Team<span class="accent">Base</span></span>
    </a>

    <nav class="main-nav">
      <a href="/" class="nav-link <%= currentPath === '/' ? 'active' : '' %>">Home</a>
      <a href="/directory" class="nav-link <%= currentPath.startsWith('/directory') ? 'active' : '' %>">Directory</a>
      <a href="/departments" class="nav-link <%= currentPath === '/departments' ? 'active' : '' %>">Departments</a>
      <a href="/skills" class="nav-link <%= currentPath === '/skills' ? 'active' : '' %>">Skills</a>
      <a href="/insights" class="nav-link <%= currentPath === '/insights' ? 'active' : '' %>">Insights</a>
      <a href="/ai" class="nav-link nav-ai <%= currentPath === '/ai' ? 'active' : '' %>"><svg class="icon icon-sm"><use href="#icon-sparkle"></use></svg> AI Assistant</a>
    </nav>
    <div class="nav-actions">
      <button type="button" class="palette-btn" id="paletteBtn" aria-label="Search (Ctrl+K)"><svg class="icon icon-sm"><use href="#icon-search"></use></svg><span>Search</span><kbd>Ctrl K</kbd></button>
      <a href="/admin/dashboard" class="btn btn-primary nav-admin">Admin</a>
    </div>
  </div>
</header>

